{
  "expo": {
    "name": "My Data Safe",
    "slug": "my-data-safe",
    "version": "1.0.0",
    "orientation": "portrait",
    "entryPoint": "./App.js",
    "android": {
      "package": "com.mydatasafe.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow this app to access your data",
          "savePhotosPermission": "Allow this app to access your data"
        }
      ]
    ]
  }
}
