{
  "expo": {
    "name": "My Data Safe",
    "slug": "my-data-safe",
    "owner": "ar76ar-devs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "entryPoint": "./App.js",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.mydatasafe.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow this app",
          "savePhotosPermission": "Allow this"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e110fb4e-8b13-4258-a657-e3d5022ca7c5"
      }
    }
  }
}
